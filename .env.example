# Copy to server/.env. The client uses /api through the Vite proxy.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/campus_booking?replicaSet=rs0
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_TTL_SECONDS=3600
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
SEED_ADMIN_NAME=Campus Administrator
SEED_ADMIN_EMAIL=admin@campus.edu
SEED_ADMIN_PASSWORD=change-this-before-seeding
